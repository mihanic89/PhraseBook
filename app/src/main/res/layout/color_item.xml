<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardUseCompatPadding="true"
    card_view:cardCornerRadius="10dp"
    android:layout_marginBottom="16dp"
    android:elevation="5dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/colorTextDefault"

            android:layout_width="match_parent"
            android:layout_height="@dimen/card_text_height"

            android:background="@color/colorPrimary"
            android:fontFamily="@font/marmelad"
            android:gravity="center_horizontal"


            android:textColor="#ffffff"
            app:autoSizeTextType="uniform"
            android:padding="@dimen/card_dimen"
            tools:text="DefaultText" />


        <ImageView
            android:id="@+id/colorImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/colorPrimary"
            android:gravity="center_horizontal"


            android:textSize="75sp"

            tools:text="TranslateText"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/colorTextTranslate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_text_height"


            android:background="@color/colorPrimaryDark"
            android:fontFamily="@font/marmelad"
            android:gravity="center_horizontal"

            android:textColor="#ffffff"
            app:autoSizeTextType="uniform"
            android:padding="@dimen/card_dimen"
            tools:text="TranslateText" />


    </LinearLayout>
</androidx.cardview.widget.CardView>